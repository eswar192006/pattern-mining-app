# Live model provider: ollama (default) or gemini.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Gemini provider settings (used only when LLM_PROVIDER=gemini).
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-3.8-flash

LLM_TIMEOUT_S=120

# `./start_demo.sh` enables local replay automatically. Set this only when starting
# the API directly and you want to use the six saved, keyless demo responses.
# DEMO_REPLAY=1

# The chat page looks for the API here (change it if you started the server on another port)
# API_URL=http://127.0.0.1:8000
